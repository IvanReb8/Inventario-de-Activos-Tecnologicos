  "item": [
    {
      "name": "POST 01 - Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Autenticación Exitosa - 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.collectionVariables.set(\"jwt_token\", jsonData.token); // Almacena el token\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"username\": \"admin\",\r\n  \"password\": \"admin\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "POST 02 - Register Asset",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Activo Creado - 201 Created\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "    var jsonData = pm.response.json();\r",
              "\r",
              "    // Valida que el Backend haya generado el UUID y el Folio secuencial automáticamente\r",
              "    pm.expect(jsonData.idTechnical).to.be.a('string');\r",
              "    pm.expect(jsonData.inventoryFolio).to.include(\"LAP-2026-\");\r",
              "\r",
              "    // Guarda el UUID para las siguientes pruebas mutadoras\r",
              "    pm.collectionVariables.set(\"last_asset_uuid\", jsonData.idTechnical);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"serialNumber\": \"SN-AUTO-2026\",\r\n  \"brandModel\": \"Dell Latitude 5440\",\r\n  \"status\": \"AVAILABLE\",\r\n  \"acquisitionCost\": 1350.00,\r\n  \"idCategory\": 1\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/assets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "assets"
          ]
        }
      },
      "response": []
    },
    {
      "name": "PUT 03 - Update Asset to Disposed",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Cambio a Baja Exitoso - 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.status).to.eql(\"DISPOSED\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"serialNumber\": \"SN-AUTO-2026\",\r\n  \"brandModel\": \"Dell Latitude 5440 - Obsoleta\",\r\n  \"status\": \"DISPOSED\", \r\n  \"acquisitionCost\": 1350.00,\r\n  \"idCategory\": 1\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/assets/{{last_asset_uuid}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "assets",
            "{{last_asset_uuid}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "PUT 04 - Try Revert Disposed Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Bloqueado Correctamente - Capturado por ExceptionHandler\", function () {\r",
              "    // Esperamos un fallo del cliente o del servidor por la restricción de negocio\r",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 500]); \r",
              "\r",
              "    var jsonData = pm.response.json();\r",
              "    // Valida que el JSON homogéneo devuelva el mensaje exacto que programamos\r",
              "    pm.expect(jsonData.message).to.include(\"Un activo con estado Baja no podrá regresar a un estado operativo posterior\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"serialNumber\": \"SN-AUTO-2026\",\r\n  \"brandModel\": \"Dell Latitude 5440 - Intento Reversión\",\r\n  \"status\": \"AVAILABLE\", // Intento ilegal de reactivación\r\n  \"acquisitionCost\": 1350.00,\r\n  \"idCategory\": 1\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/assets/{{last_asset_uuid}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "assets",
            "{{last_asset_uuid}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET 05 - Export ZIP Report",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"ZIP Generado en Memoria - 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "    var jsonData = pm.response.json();\r",
              "\r",
              "    // Valida la estructura del DTO de descarga adaptado a ZIP\r",
              "    pm.expect(jsonData.status).to.eql(200);\r",
              "    pm.expect(jsonData.fileName).to.eql(\"inventario.zip\");\r",
              "    pm.expect(jsonData.fileBase64).to.be.a('string'); // Cadena binaria lista para Angular\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/assets/export?status=DISPOSED",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "assets",
            "export"
          ],
          "query": [
            {
              "key": "status",
              "value": "DISPOSED"
            }
          ]
        }
      },
      "response": []
    }
